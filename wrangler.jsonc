{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-clarte",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // ⚠️ BEFORE DEPLOYING: replace the id below with your real Cloudflare KV
  // Namespace (`wrangler kv namespace create studio-clarte-kv`).
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "studio-clarte-kv-local"
    }
  ],
  // ⚠️ DEPLOYMENT-SPECIFIC VARS — set them in the CLOUDFLARE DASHBOARD ONLY
  // (Workers → studio-clarte → Settings → Variables and Secrets), NEVER in
  // this public file:
  //   AGENCY_DOMAIN   → your studio subdomain (e.g. studio.cedricv.com)
  //   DEFAULT_SITE_ID → site opened by default on the agency domain (agence)
  //   SITE_DOMAINS    → {"client-a":"studio.client-a.ch", ...}
  //   SITE_OVERRIDES  → {"agence":{"repo":"your-org/your-site",
  //                      "cdnDomain":"https://cdn.your-domain.com",
  //                      "r2AccountId":"...","r2Bucket":"..."}}
  // Keeping them out of this file prevents deploys from overwriting your
  // private configuration (dashboard vars persist across deploys).
  "vars": {
    "SESSION_TTL_SECONDS": 604800
  }
  // Storage model: DEDICATED per-site R2, no webmaster bucket.
  // Per site, either:
  //   • own R2 → r2AccountId/r2Bucket in SITE_OVERRIDES + the site's
  //     R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in the vault (⚙️ Settings);
  //   • Git fallback → images are committed into the site repo.
  //
  // Secrets to create via `wrangler secret put <NAME>` (or dashboard) :
  //   VAULT_MASTER_KEY, OAUTH_GITHUB_CLIENT_ID, OAUTH_GITHUB_CLIENT_SECRET,
  //   ALLOWED_GITHUB_LOGINS, DEEPSEEK_API_KEY / GITHUB_PAT (global fallback,
  //   AGENCY site only — clients must configure their own keys in ⚙️)
}
