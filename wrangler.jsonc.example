{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-clarte",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // ═══════════════════════════════════════════════════════════════════
  // TEMPLATE — copy this file to `wrangler.jsonc` (GITIGNORED) and fill in
  // YOUR values. Why: this repo is PUBLIC, and `git pull` must never
  // overwrite your local config.
  //
  // ⚠️ SPLIT OF RESPONSIBILITIES — this is the single source of truth:
  //   • THIS FILE (local, gitignored): ALL plain vars — the KV namespace id,
  //     SESSION_TTL_SECONDS, AND the deployment vars (AGENCY_DOMAIN,
  //     DEFAULT_SITE_ID, SITE_DOMAINS, SITE_OVERRIDES).
  //   • `wrangler secret put <NAME>` (or the dashboard SECRETS section):
  //     secrets only — VAULT_MASTER_KEY, DEEPSEEK_API_KEY,
  //     OAUTH_GITHUB_CLIENT_ID/SECRET, ALLOWED_GITHUB_LOGINS.
  //
  // ⚠️ WHY plain vars MUST be here and NOT in the dashboard:
  // Cloudflare's Workers "Versions & Deployments" model bakes plain vars
  // into each VERSION. Every `wrangler deploy` rebuilds the version from
  // THIS file — vars set ONLY in the dashboard are silently DROPPED on the
  // next deploy (this exact bug broke studio.cedricv.com TWICE, returning
  // "Domain not configured" 404s). Secrets are worker-level and DO survive
  // deploys, which is why they are the only thing kept in the dashboard.
  // ═══════════════════════════════════════════════════════════════════
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<KV_NAMESPACE_ID>" // `npx wrangler kv namespace list`
    }
  ],
  "vars": {
    // ── Plain deployment vars — MUST live here (gitignored), never the dashboard ──
    // Studio subdomain (Super-Admin mode + default working site).
    "AGENCY_DOMAIN": "studio.yourdomain.com",
    // Site opened by default on the agency domain.
    "DEFAULT_SITE_ID": "agence",
    // JSON map siteId → client custom domain, e.g. {"client-a":"studio.client-a.ch"}
    "SITE_DOMAINS": "{}",
    // JSON map siteId → partial site overrides (repo, cdnDomain, r2…).
    // e.g. {"agence":{"name":"Your Site Name","repo":"your-org/your-site","cdnDomain":"https://cdn.your-domain.com"}}
    "SITE_OVERRIDES": "{}",
    "SESSION_TTL_SECONDS": 604800
  }
  // ── Secrets — `npx wrangler secret put <NAME>` (or dashboard Secrets) ─────────
  //   VAULT_MASTER_KEY, DEEPSEEK_API_KEY, OAUTH_GITHUB_CLIENT_ID,
  //   OAUTH_GITHUB_CLIENT_SECRET, ALLOWED_GITHUB_LOGINS
  //
  // Storage model: DEDICATED per-site R2, no webmaster bucket.
  // Per site, either:
  //   • own R2 → r2AccountId/r2Bucket in SITE_OVERRIDES + the site's
  //     R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in the vault (⚙️ Settings);
  //   • Git fallback → images are committed into the site repo.
}
