{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-clarte",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // ═══════════════════════════════════════════════════════════════════
  // TEMPLATE — copy this file to `wrangler.jsonc` (GITIGNORED) and fill in
  // YOUR values. Why: this repo is PUBLIC, and `git pull` must never
  // overwrite your local config.
  //
  // ⚠️ SPLIT OF RESPONSIBILITIES — the single source of truth matters:
  //   • THIS FILE (local, gitignored): ONLY the KV namespace id and
  //     SESSION_TTL_SECONDS — everything that `wrangler deploy` needs.
  //   • THE CLOUDFLARE DASHBOARD (Workers → studio-clarte → Settings →
  //     Variables and Secrets): the PRIVATE deployment vars —
  //     AGENCY_DOMAIN, DEFAULT_SITE_ID, SITE_DOMAINS, SITE_OVERRIDES.
  //
  // NEVER put those private vars in this file: `wrangler deploy` would push
  // the file values and OVERWRITE your dashboard configuration.
  // ═══════════════════════════════════════════════════════════════════
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<KV_NAMESPACE_ID>" // `npx wrangler kv namespace list`
    }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": 604800
  }
  // ── Private vars — set in the DASHBOARD ONLY (never here) ──────────
  //   AGENCY_DOMAIN  → your studio subdomain (e.g. studio.yourdomain.com)
  //   DEFAULT_SITE_ID → site opened by default on the agency domain (agence)
  //   SITE_DOMAINS   → {"client-a":"studio.client-a.ch", ...}
  //   SITE_OVERRIDES → {"client-a":{"repo":"your-org/your-site",
  //                      "cdnDomain":"https://cdn.your-domain.com",
  //                      "r2AccountId":"...","r2Bucket":"..."}}
  //                    (any entry without a seed = a NEW client site)
  //
  // Storage model: DEDICATED per-site R2, no webmaster bucket.
  // Per site, either:
  //   • own R2 → r2AccountId/r2Bucket in SITE_OVERRIDES + the site's
  //     R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in the vault (⚙️ Settings);
  //   • Git fallback → images are committed into the site repo.
  //
  // Secrets to create via `wrangler secret put <NAME>` (or dashboard) :
  //   VAULT_MASTER_KEY, OAUTH_GITHUB_CLIENT_ID, OAUTH_GITHUB_CLIENT_SECRET,
  //   ALLOWED_GITHUB_LOGINS, DEEPSEEK_API_KEY / GITHUB_PAT (global fallback,
  //   AGENCY site only — clients configure their own keys in ⚙️)
}
