{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-clarte",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // ═══════════════════════════════════════════════════════════════════
  // TEMPLATE — copy this file to `wrangler.jsonc` (GITIGNORED) and replace
  // every <...> placeholder with YOUR real values.
  //
  // Why: this repo is PUBLIC. `wrangler.jsonc` (the real file) is never
  // committed — `git pull` never touches it and every deploy uses YOUR
  // values consistently. No more manual dashboard edits.
  // ═══════════════════════════════════════════════════════════════════
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<KV_NAMESPACE_ID>" // `npx wrangler kv namespace list`
    }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": 604800,
    // Site registry — domains are deployment config, never hardcoded in code.
    "AGENCY_DOMAIN": "<AGENCY_DOMAIN>", // ex. "studio.cedricv.com" → Super-Admin + default site
    "DEFAULT_SITE_ID": "agence",
    "SITE_DOMAINS": "{}", // ex. {"client-a":"studio.client-a.ch"}
    // ex. {"agence":{"repo":"your-org/your-site","cdnDomain":"https://cdn.your-domain.com",
    //      "r2AccountId":"<account-id>","r2Bucket":"cedricv-media"}}
    "SITE_OVERRIDES": "{}"
  }
  // Storage model: DEDICATED per-site R2, no webmaster bucket.
  // Per site, either:
  //   • own R2 → r2AccountId/r2Bucket in SITE_OVERRIDES + the site's
  //     R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in the vault (⚙️ Settings);
  //   • Git fallback → images are committed into the site repo.
  //
  // Secrets to create via `wrangler secret put <NAME>` (or dashboard) :
  //   VAULT_MASTER_KEY, OAUTH_GITHUB_CLIENT_ID, OAUTH_GITHUB_CLIENT_SECRET,
  //   ALLOWED_GITHUB_LOGINS, DEEPSEEK_API_KEY / GITHUB_PAT (global fallback,
  //   AGENCY site only — clients configure their own keys in ⚙️)
}
