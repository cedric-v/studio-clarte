# ═══════════════════════════════════════════════════════════════════
# STUDIO CLARTÉ — Environment variables (example)
# Copy to `.dev.vars` for local development (Astro + Wrangler),
# and configure these values as Cloudflare Secrets/Vars in production.
# ═══════════════════════════════════════════════════════════════════

# ── API key vault (AES-256-GCM, Web Crypto) ────────────────────────
# Master key (>= 16 chars) — derived via SHA-256 into an AES-256 key.
# In production: store as a Cloudflare SECRET.
VAULT_MASTER_KEY=change-me-master-key-32chars+
#
# Storage model: DEDICATED per-site R2, no webmaster bucket.
# Each site either:
#   • has its own R2 (r2AccountId/r2Bucket in SITE_OVERRIDES + its
#     R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY in the site vault ⚙️), or
#   • falls back to GIT: images are committed into the site repo
#     (public/images/…) with the draft PR.
# There is NO global bucket fallback.

# ── Global fallbacks (priority: client vault > env) ────────────────
DEEPSEEK_API_KEY=sk-votre-cle-deepseek
GITHUB_PAT=github_pat_votre_pat_avec_scope_repo

# ── GitHub OAuth (collaborator login) ──────────────────────────────
# Create a GitHub OAuth App: Settings → Developer settings → OAuth Apps
# Callback URL: https://<studio-subdomain>/api/auth/callback (e.g. https://studio.cedricv.com/api/auth/callback)
OAUTH_GITHUB_CLIENT_ID=Ov23li-exemple
OAUTH_GITHUB_CLIENT_SECRET=secret-oauth-exemple
# Optional whitelist (comma-separated) — empty = any GitHub account accepted
ALLOWED_GITHUB_LOGINS=

# ── Site registry (domains are deployment config — never hardcoded) ──
# The webmaster's studio subdomain → Super-Admin mode + default working site.
AGENCY_DOMAIN=studio.example.com
# Site opened by default on the agency domain (default: the agency site id).
DEFAULT_SITE_ID=agence
# JSON map siteId → custom client domain, e.g. {"client-a":"studio.client-a.ch"}
SITE_DOMAINS={}
# JSON map siteId → partial site overrides (repo, cdnDomain, name, systemPromptAddon…)
# e.g. {"agence":{"repo":"cedric-v/cedricv.com","cdnDomain":"https://cdn.cedricv.com"}}
SITE_OVERRIDES={}

# ── Session ────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=604800
