---
import Header from '../components/Header.astro';
import ChatStudio from '../components/ChatStudio.astro';
import PayloadPreview from '../components/PayloadPreview.astro';
import WorkflowTracker from '../components/WorkflowTracker.astro';
import SettingsModal from '../components/SettingsModal.astro';
import ToastContainer from '../components/ToastContainer.astro';
import { listSites } from '../config/sites';
import { DEFAULT_MODEL_ID, DEFAULT_PROVIDER_ID, getAiProvider } from '../lib/ai';
import { readAiConfig } from '../lib/vault';
import { t } from '../i18n';
import '../styles/global.css';

const { siteConfig, user, isAgency, lang } = Astro.locals;

if (!siteConfig) {
  return Astro.redirect('/login');
}

const brandColor = siteConfig.theme?.primaryColor ?? '#3b82f6';
const siteId = siteConfig.id;
// Super-Admin only: the full site list powers the site switcher.
// Clients never receive the registry (multi-tenant isolation).
const sites = isAgency ? listSites(Astro.locals.env) : [];

// The site's ACTIVE AI provider · model (chosen in ⚙️ Settings) — rendered
// as a small badge under the composer so the user always sees what generates.
const storedAi = await readAiConfig(Astro.locals.env, siteConfig.id);
const activeProvider =
  (storedAi && getAiProvider(storedAi.provider)) || getAiProvider(DEFAULT_PROVIDER_ID)!;
const activeModel = (storedAi?.model || '').trim() || DEFAULT_MODEL_ID;
const activeAiLabel = `${activeProvider.label} · ${activeModel}`;
---

<!doctype html>
<html lang={lang} data-lang={lang} data-brand={brandColor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{siteConfig.name} — Studio Clarté</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Client dynamic theme (white label) -->
    <style is:global>
      :root {
        --brand-primary: {brandColor};
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <Header site={siteConfig} user={user} isAgency={isAgency} sites={sites} activeSiteId={siteId} />

      <main class="layout">
        <!-- Mobile tabs (CSS-first radio) -->
        <input type="radio" name="sc-tab" id="tab-chat" class="tab-radio" checked />
        <input type="radio" name="sc-tab" id="tab-workspace" class="tab-radio" />
        <nav class="mobile-tabs" aria-label="Navigation">
          <label for="tab-chat">{t(lang, 'tabs.chat')}</label>
          <label for="tab-workspace">{t(lang, 'tabs.workspace')}</label>
        </nav>

        <!-- Column 1: AI chat -->
        <section class="pane pane-chat" aria-label={t(lang, 'tabs.chat')}>
          <ChatStudio site={siteConfig} user={user} activeAiLabel={activeAiLabel} />
        </section>

        <!-- Resizable divider (desktop only) -->
        <div
          class="pane-divider"
          id="pane-divider"
          role="separator"
          aria-orientation="vertical"
          aria-label="Chat width"
          tabindex="0"
        ></div>

        <!-- Column 2: Workspace (multi-file preview + CI/CD stepper) -->
        <section class="pane pane-workspace" aria-label={t(lang, 'tabs.workspace')}>
          <PayloadPreview />
          <WorkflowTracker siteId={siteId} siteName={siteConfig.name} branch={siteConfig.defaultBranch} />
        </section>
      </main>

      <SettingsModal site={siteConfig} />
      <ToastContainer />

      <footer class="app-footer">
        <a href="https://cedricv.com/fr/site-web-rapide/" target="_blank" rel="noopener noreferrer">
          Réalisé par Cédric V.
        </a>
      </footer>
    </div>
  </body>
</html>

<script>
  // Resizable chat panel (desktop). Width persisted in localStorage.
  // Keyboard: focus the divider and use ← → arrow keys.
  const layout = document.querySelector('.layout') as HTMLElement;
  const divider = document.getElementById('pane-divider') as HTMLElement;
  const CHAT_KEY = 'sc:chat-width';
  const MIN = 320;
  const MAX_RATIO = 0.7;

  function applyWidth(px: number) {
    const max = Math.round(window.innerWidth * MAX_RATIO);
    const width = Math.min(max, Math.max(MIN, px));
    layout.style.setProperty('--chat-width', `${width}px`);
    localStorage.setItem(CHAT_KEY, String(width));
  }

  // Restore the saved width on load.
  const saved = Number(localStorage.getItem(CHAT_KEY));
  if (saved) layout.style.setProperty('--chat-width', `${saved}px`);

  if (divider) {
    let dragging = false;
    divider.addEventListener('pointerdown', (event) => {
      dragging = true;
      divider.setPointerCapture(event.pointerId);
      document.body.classList.add('resizing');
      event.preventDefault();
    });
    divider.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const rect = layout.getBoundingClientRect();
      applyWidth(event.clientX - rect.left);
    });
    divider.addEventListener('pointerup', () => {
      dragging = false;
      document.body.classList.remove('resizing');
    });
    divider.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const current =
        Number.parseFloat(getComputedStyle(layout).getPropertyValue('--chat-width')) || 460;
      applyWidth(current + (event.key === 'ArrowRight' ? 24 : -24));
    });
  }
</script>
