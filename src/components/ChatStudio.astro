---
import { t } from '../i18n';
import { AI_PROVIDER_META, DEFAULT_MODEL_ID, DEFAULT_PROVIDER_ID } from '../lib/ai';
import type { SiteConfig } from '../config/sites';
import type { SessionUser } from '../env';

interface Props {
  site: SiteConfig;
  user: SessionUser | null;
}

const { site, user } = Astro.props;
const { lang } = Astro.locals;

// Greeting: the person's FIRST NAME when GitHub exposes it, otherwise the
// GitHub login — never the site name (best practice for personal onboarding).
const greeting = user?.name?.trim().split(/\s+/)[0] || user?.login || site.name;

const SUGGESTION_KEYS = ['chat.suggestion1', 'chat.suggestion2', 'chat.suggestion3'];

// Provider/model metadata embedded for the client-side pickers (no secrets).
const aiMetaJson = JSON.stringify(AI_PROVIDER_META);
const aiDefaultsJson = JSON.stringify({ provider: DEFAULT_PROVIDER_ID, model: DEFAULT_MODEL_ID });
---

<div class="chat-panel" id="chat-studio">
  <!-- Messages -->
  <div class="chat-messages" id="chat-messages">
    <div class="welcome">
      <div class="welcome-title">{t(lang, 'chat.welcomeTitle', greeting)}</div>
      <p class="welcome-text">{t(lang, 'chat.welcomeText')}</p>
      <div class="chips" id="suggestion-chips">
        {SUGGESTION_KEYS.map((key) => (
          <button class="chip" type="button" data-suggestion={t(lang, key)}>{t(lang, key)}</button>
        ))}
      </div>
    </div>
  </div>

  <!-- Composer -->
  <div class="chat-composer">
    <!-- AI provider + model selection (persisted per browser) -->
    <div class="model-selector" id="model-selector" data-providers={aiMetaJson} data-defaults={aiDefaultsJson}>
      <label class="model-field">
        <span class="model-label">{t(lang, 'chat.aiProvider')}</span>
        <select id="ai-provider" class="model-select" aria-label={t(lang, 'chat.aiProvider')}></select>
      </label>
      <label class="model-field">
        <span class="model-label">{t(lang, 'chat.aiModel')}</span>
        <select id="ai-model" class="model-select" aria-label={t(lang, 'chat.aiModel')}></select>
      </label>
      <input
        type="text"
        id="ai-custom-model"
        class="model-custom"
        placeholder={t(lang, 'chat.customModelPlaceholder')}
        aria-label={t(lang, 'chat.customModel')}
        spellcheck="false"
        hidden
      />
      <span class="model-badge" id="ai-model-badge" title={t(lang, 'chat.modelActive')}></span>
    </div>

    <div class="composer-strip" id="image-strip" hidden></div>
    <div class="composer-row">
      <button class="icon-btn" id="btn-attach" type="button" title={t(lang, 'chat.attach')}>📎</button>
      <div class="composer-box">
        <textarea
          id="chat-input"
          rows="2"
          placeholder={t(lang, 'chat.placeholder')}
          aria-label={t(lang, 'chat.placeholder')}
        ></textarea>
        <div class="composer-actions">
          <button class="composer-action" id="btn-expand" type="button" title={t(lang, 'chat.expandInput')} aria-label={t(lang, 'chat.expandInput')}>⤢</button>
          <button class="send-btn" id="btn-send" type="button" title={t(lang, 'chat.sendTitle')} aria-label={t(lang, 'chat.send')}>↑</button>
        </div>
      </div>
    </div>
    <input type="file" id="file-input" accept="image/*" multiple hidden />
    <p class="composer-hint">{t(lang, 'chat.composerHint')}</p>
  </div>
</div>

<script>
  import { emit, getState, on, persistState, toast, type ChatMessage } from '../lib/client-state';
  import { uploadImage } from '../lib/client-upload';
  import { getClientLocale, t } from '../i18n';
  import { renderMarkdown } from '../lib/markdown-lite';

  const lang = getClientLocale();
  let state = getState();
  const messagesEl = document.getElementById('chat-messages')!;
  const inputEl = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('btn-send') as HTMLButtonElement;
  const attachBtn = document.getElementById('btn-attach') as HTMLButtonElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const stripEl = document.getElementById('image-strip')!;

  interface PendingImage {
    kind: 'r2' | 'git';
    /** R2 mode: public CDN URL. */
    url?: string;
    /** Git mode: repo path + relative reference + local data URL. */
    path?: string;
    ref?: string;
    dataUrl?: string;
    alt: string;
  }

  let pendingImages: PendingImage[] = [];
  let streaming = false;

  // Git-fallback images waiting to be committed with the next draft PR.
  let gitImages: { path: string; alt: string; dataUrl: string }[] = [];

  // Escapes values inserted into innerHTML (user file names, …)
  function escapeHtml(src: string): string {
    return src
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  // ── Rendering ────────────────────────────────────────────────────
  function scrollBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function renderMessage(message: ChatMessage): HTMLElement {
    const div = document.createElement('div');
    div.className = `msg ${message.role === 'user' ? 'msg-user' : 'msg-assistant'}`;
    const images = (message.images ?? [])
      .map(
        (img) =>
          `<figure class="md-figure"><img src="${escapeHtml(img.url ?? img.dataUrl ?? '')}" alt="${escapeHtml(img.alt)}" loading="lazy" /><figcaption>${escapeHtml(img.alt)}</figcaption></figure>`,
      )
      .join('');
    div.innerHTML = images + renderMarkdown(message.content);
    if (message.payload) {
      const note = document.createElement('div');
      note.className = 'payload-note';
      note.textContent = t(lang, 'chat.payloadNote');
      div.appendChild(note);
    }
    messagesEl.appendChild(div);
    scrollBottom();
    return div;
  }

  const welcomeEl = messagesEl.querySelector<HTMLElement>('.welcome');

  function renderAll() {
    messagesEl.innerHTML = '';
    if (welcomeEl && state.messages.length === 0) messagesEl.appendChild(welcomeEl);
    for (const message of state.messages) renderMessage(message);
  }

  // ── Images (paste / drag&drop / button) ──────────────────────────
  async function handleFiles(files: FileList | File[]) {
    const list = Array.from(files).filter((file) => file.type.startsWith('image/'));
    if (!list.length) {
      toast(t(lang, 'chat.toastImagesOnly'), 'error');
      return;
    }
    for (const file of list) {
      try {
        toast(t(lang, 'chat.toastCompressing', file.name), 'info');
        const uploaded = await uploadImage(file);
        const alt = t(lang, 'chat.imageAlt', file.name);
        if (uploaded.mode === 'r2') {
          pendingImages.push({ kind: 'r2', url: uploaded.publicUrl, alt });
        } else {
          pendingImages.push({
            kind: 'git',
            path: uploaded.path,
            ref: uploaded.ref,
            dataUrl: uploaded.dataUrl,
            alt,
          });
          gitImages.push({ path: uploaded.path, alt, dataUrl: uploaded.dataUrl });
          toast(t(lang, 'chat.toastGitMode'), 'info');
        }
        renderStrip();
        toast(
          uploaded.compressed
            ? t(lang, 'chat.toastOptimized', formatBytes(file.size))
            : t(lang, 'chat.toastUploaded'),
          'success',
        );
      } catch (error) {
        console.error('[upload]', error);
        toast(error instanceof Error ? error.message : t(lang, 'chat.toastUploadFailed'), 'error');
      }
    }
  }

  function renderStrip() {
    stripEl.hidden = pendingImages.length === 0;
    stripEl.innerHTML = '';
    pendingImages.forEach((img, index) => {
      const thumb = document.createElement('div');
      thumb.className = 'thumb';
      thumb.innerHTML = `<img src="${escapeHtml(img.url ?? img.dataUrl ?? '')}" alt="${escapeHtml(img.alt)}" /><button class="thumb-x" type="button" title="Remove">✕</button>`;
      thumb.querySelector('.thumb-x')?.addEventListener('click', () => {
        pendingImages.splice(index, 1);
        renderStrip();
      });
      stripEl.appendChild(thumb);
    });
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  inputEl.addEventListener('paste', (event) => {
    const items = event.clipboardData?.items ?? [];
    const files = Array.from(items)
      .filter((item) => item.kind === 'file' && item.type.startsWith('image/'))
      .map((item) => item.getAsFile())
      .filter((file): file is File => file !== null);
    if (files.length) {
      event.preventDefault();
      void handleFiles(files);
    }
  });

  for (const type of ['dragover', 'dragenter']) {
    messagesEl.addEventListener(type, (event) => {
      event.preventDefault();
      messagesEl.classList.add('dragging');
    });
  }
  messagesEl.addEventListener('dragleave', () => messagesEl.classList.remove('dragging'));
  messagesEl.addEventListener('drop', (event) => {
    event.preventDefault();
    messagesEl.classList.remove('dragging');
    void handleFiles(event.dataTransfer?.files ?? []);
  });

  attachBtn.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files) void handleFiles(fileInput.files);
    fileInput.value = '';
  });

  // ── Suggestions ──────────────────────────────────────────────────
  document.getElementById('suggestion-chips')?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!button) return;
    inputEl.value = button.dataset.suggestion ?? '';
    inputEl.focus();
  });

  // ── AI provider / model picker (persisted per browser) ──────────
  interface AiModelMeta {
    id: string;
    label: string;
  }
  interface AiProviderMeta {
    id: string;
    label: string;
    customModels: boolean;
    models: AiModelMeta[];
  }
  interface AiChoice {
    provider: string;
    model: string;
    /** Per-provider last-used model (kept when switching providers). */
    byProvider: Record<string, string>;
  }

  const providerSelect = document.getElementById('ai-provider') as HTMLSelectElement;
  const modelSelect = document.getElementById('ai-model') as HTMLSelectElement;
  const customModelInput = document.getElementById('ai-custom-model') as HTMLInputElement;
  const modelBadge = document.getElementById('ai-model-badge') as HTMLElement;

  const selectorEl = document.getElementById('model-selector') as HTMLElement;
  const providers = JSON.parse(selectorEl?.dataset.providers ?? '[]') as AiProviderMeta[];
  const aiDefaults = JSON.parse(selectorEl?.dataset.defaults ?? '{}') as {
    provider: string;
    model: string;
  };

  const AI_CHOICE_KEY = 'sc:ai-choice';

  function loadAiChoice(): AiChoice {
    try {
      const raw = localStorage.getItem(AI_CHOICE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw) as Partial<AiChoice>;
        return {
          provider: typeof parsed.provider === 'string' ? parsed.provider : aiDefaults.provider,
          model: typeof parsed.model === 'string' ? parsed.model : aiDefaults.model,
          byProvider: parsed.byProvider ?? {},
        };
      }
    } catch {
      // Corrupted storage → fall through to defaults.
    }
    return { provider: aiDefaults.provider, model: aiDefaults.model, byProvider: {} };
  }
  function saveAiChoice() {
    try {
      localStorage.setItem(AI_CHOICE_KEY, JSON.stringify(aiChoice));
    } catch {
      // Private mode / quota → best effort.
    }
  }

  let aiChoice = loadAiChoice();

  function activeProvider(): AiProviderMeta | undefined {
    return providers.find((provider) => provider.id === aiChoice.provider) ?? providers[0];
  }

  function populateProviders() {
    providerSelect.innerHTML = '';
    for (const provider of providers) {
      const option = document.createElement('option');
      option.value = provider.id;
      option.textContent = provider.label;
      providerSelect.appendChild(option);
    }
    providerSelect.value = activeProvider()?.id ?? '';
  }

  function populateModels() {
    const provider = activeProvider();
    if (!provider) return;
    modelSelect.innerHTML = '';
    for (const model of provider.models) {
      const option = document.createElement('option');
      option.value = model.id;
      option.textContent = model.label;
      modelSelect.appendChild(option);
    }
    if (provider.customModels) {
      const option = document.createElement('option');
      option.value = '__custom__';
      option.textContent = t(lang, 'chat.customModel');
      modelSelect.appendChild(option);
    }

    // Restore the last model used with THIS provider (per-provider memory).
    const saved = aiChoice.byProvider[provider.id] ?? '';
    const isPreset = provider.models.some((model) => model.id === saved);
    if (!provider.models.length && provider.customModels) {
      // Provider without a fixed catalogue (self-hosted gateway…) → the
      // free-form input is the DEFAULT state.
      modelSelect.value = '__custom__';
      customModelInput.value = saved;
      customModelInput.hidden = false;
    } else if (saved && !isPreset && provider.customModels) {
      // A free-form model was used before → reopen the free input.
      modelSelect.value = '__custom__';
      customModelInput.value = saved;
      customModelInput.hidden = false;
    } else {
      modelSelect.value = isPreset ? saved : (provider.models[0]?.id ?? '');
      customModelInput.value = '';
      customModelInput.hidden = true;
    }
  }

  /** Current effective model id (preset or free-form). */
  function currentModelId(): string {
    const provider = activeProvider();
    if (!provider) return '';
    if (modelSelect.value === '__custom__') {
      return customModelInput.value.trim() || provider.models[0]?.id || '';
    }
    return modelSelect.value || provider.models[0]?.id || '';
  }

  function syncChoice() {
    const provider = activeProvider();
    if (!provider) return;
    const model = currentModelId();
    aiChoice = { provider: provider.id, model, byProvider: { ...aiChoice.byProvider, [provider.id]: model } };
    saveAiChoice();
    modelBadge.textContent = `${provider.label} · ${model || '—'}`;
  }

  providerSelect.addEventListener('change', () => {
    aiChoice = { provider: providerSelect.value, model: '', byProvider: aiChoice.byProvider };
    populateModels();
    syncChoice();
  });
  modelSelect.addEventListener('change', () => {
    if (modelSelect.value === '__custom__') {
      customModelInput.hidden = false;
      customModelInput.focus();
    } else {
      customModelInput.hidden = true;
    }
    syncChoice();
  });
  customModelInput.addEventListener('input', syncChoice);

  populateProviders();
  populateModels();
  syncChoice();

  // ── Send / AI streaming (provider + model selectable) ───────────
  function extractPayload(text: string): { title: string; summary: string; files: unknown[] } | null {
    const tryParse = (candidate: string) => {
      try {
        const obj = JSON.parse(candidate);
        if (obj && typeof obj === 'object' && Array.isArray(obj.files)) {
          return obj as { title: string; summary: string; files: unknown[] };
        }
      } catch {
        return null;
      }
      return null;
    };

    // 1. Fenced block (```json … ```) — the model is instructed to end with it.
    const fenced = text.match(/```(?:json)?\s*([\s\S]*?)```/g);
    if (fenced) {
      for (const block of [...fenced].reverse()) {
        const inner = block.replace(/^```(?:json)?\s*/, '').replace(/```\s*$/, '');
        const parsed = tryParse(inner.trim());
        if (parsed) return parsed;
      }
    }

    // 2. Last balanced {...} object in the text.
    const start = text.indexOf('{');
    if (start === -1) return null;
    let depth = 0;
    let inString = false;
    let escaped = false;
    for (let i = start; i < text.length; i++) {
      const ch = text[i];
      if (inString) {
        if (escaped) escaped = false;
        else if (ch === '\\') escaped = true;
        else if (ch === '"') inString = false;
        continue;
      }
      if (ch === '"') inString = true;
      else if (ch === '{') depth++;
      else if (ch === '}') {
        depth--;
        if (depth === 0) {
          const parsed = tryParse(text.slice(start, i + 1));
          if (parsed) return parsed;
          break;
        }
      }
    }
    return null;
  }

  /**
   * Heuristic truncation detection: the response ends inside an unclosed
   * JSON structure, an unclosed string, or an open escape — typically when
   * the model output exceeded its token limit.
   */
  function isTruncated(text: string): boolean {
    const trimmed = text.trimEnd();
    if (!trimmed) return false;
    let depth = 0;
    let inString = false;
    let escaped = false;
    for (const ch of trimmed) {
      if (inString) {
        if (escaped) escaped = false;
        else if (ch === '\\') escaped = true;
        else if (ch === '"') inString = false;
        continue;
      }
      if (ch === '"') inString = true;
      else if (ch === '{' || ch === '[') depth++;
      else if (ch === '}' || ch === ']') depth--;
    }
    return depth > 0 || inString || escaped;
  }

  /** Current draft as context so the AI iterates on it (not on main). */
  function buildDraftContext(files: { path: string; content: string }[]): string {
    return (
      '[BROUILLON EN COURS — NON PUBLIÉ]\n' +
      "Ce sont les fichiers du brouillon actuel (pas encore publié). Si l'utilisateur demande des ajustements (modification, réorganisation, correction…), planifie-les sur CES fichiers — le système régénérera chaque fichier séparément. Ne colle JAMAIS le contenu d'un fichier dans ta réponse : renvoie uniquement le plan.\n\n" +
      files.map((file) => `### ${file.path}\n${file.content}`).join('\n\n') +
      '\n[FIN DU BROUILLON]'
    );
  }

  /** Markdown reference of an image (CDN URL or relative repo path). */
  function imageMarkdown(img: { url?: string; ref?: string; alt: string }): string {
    return img.url ? `![${img.alt}](${img.url})` : `![${img.alt}](${img.ref ?? ''})`;
  }

  async function send() {
    if (streaming) return;
    const text = inputEl.value.trim();
    const images = [...pendingImages];
    if (!text && !images.length) return;

    const userMessage: ChatMessage = {
      role: 'user',
      content: text || t(lang, 'chat.attachedImage'),
      images: images.map((img) => ({
        url: img.kind === 'r2' ? img.url : undefined,
        dataUrl: img.kind === 'git' ? img.dataUrl : undefined,
        alt: img.alt,
      })),
    };
    state.messages.push(userMessage);
    persistState();
    renderMessage(userMessage);

    inputEl.value = '';
    pendingImages = [];
    renderStrip();
    scrollBottom();

    const history = state.messages.map((message) => ({
      role: message.role,
      content:
        (message.images?.length
          ? message.images.map((img) => imageMarkdown(img)).join('\n\n') + '\n\n'
          : '') + message.content,
    }));

    // Iteration support: attach the current un-published DRAFT so follow-up
    // messages adjust THESE files (not the published repo version).
    const draftContext = state.payload?.files?.length
      ? buildDraftContext(state.payload.files)
      : '';
    const sendHistory = draftContext
      ? [...history.slice(-11), { role: 'user', content: draftContext }]
      : history.slice(-12);

    streaming = true;
    sendBtn.disabled = true;
    sendBtn.textContent = '…';
    const bubble = document.createElement('div');
    bubble.className = 'msg msg-assistant';
    bubble.innerHTML = '<span class="typing">…</span>';
    messagesEl.appendChild(bubble);
    scrollBottom();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          messages: sendHistory,
          draft: state.payload?.files ?? [],
          provider: aiChoice.provider,
          model: aiChoice.model,
        }),
      });
      if (!res.ok) {
        const error = (await res.json().catch(() => null)) as { error?: string } | null;
        bubble.textContent = `⚠️ ${error?.error ?? `Error ${res.status}`}`;
        return;
      }

      const reader = res.body?.getReader();
      const decoder = new TextDecoder();
      let acc = '';
      if (reader) {
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          acc += decoder.decode(value, { stream: true });
          bubble.innerHTML = renderMarkdown(acc);
          scrollBottom();
        }
        acc += decoder.decode();
      }

      // Out-of-band delivery: the generator stores the payload server-side
      // (KV, 2h TTL) and the stream carries a compact [[PAYLOAD:<uuid>]]
      // marker — the chat response never ships the 15-30 KB JSON itself
      // (that is what truncated in production). Fetch it, fall back to the
      // inline JSON parser for legacy/fallback responses.
      let payload: { title: string; summary: string; files: unknown[] } | null =
        extractPayload(acc);
      const marker = acc.match(
        /\[\[PAYLOAD:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\]\]/,
      );
      if (marker) {
        try {
          const res = await fetch(`/api/draft/${marker[1]}`);
          if (res.ok) payload = (await res.json()) as typeof payload;
          else console.error('[chat] draft fetch failed:', res.status);
        } catch (error) {
          console.error('[chat] draft fetch error:', error);
        }
      }

      // Display: strip the marker; show the summary instead of raw JSON.
      let display = acc.replace(/\[\[PAYLOAD:[^\]]+\]\]/g, '').trim() || '(empty response)';
      if (payload && !payload.files.length) {
        display = payload.summary || payload.title || display;
        bubble.innerHTML = renderMarkdown(display);
        scrollBottom();
      }

      // Cancel intent: the model emitted [[CANCEL_DRAFT]] → discard the
      // pending draft (chat history is kept) and clear the preview panel.
      // An open preview PR (if any) stays tracked and remains on GitHub.
      const cancelRequested = /\[\[\s*CANCEL_DRAFT\s*\]\]/.test(acc);
      if (cancelRequested) {
        display = display.replace(/\[\[\s*CANCEL_DRAFT\s*\]\]/g, '').trim();
        const hadWorkflow = Boolean(state.workflow);
        state.payload = null;
        persistState();
        emit('sc:payload-cleared', null);
        gitImages = [];
        display = display || t(lang, 'chat.cancelDraftDone');
        if (hadWorkflow) display += '\n\n' + t(lang, 'chat.cancelDraftPrOpen');
        bubble.innerHTML = renderMarkdown(display);
        scrollBottom();
        toast(hadWorkflow ? t(lang, 'chat.cancelDraftPrOpen') : t(lang, 'chat.cancelDraftDone'), 'info');
      }

      const assistantMessage: ChatMessage = {
        role: 'assistant',
        content: display,
        payload: Boolean(payload && payload.files.length),
      };
      state.messages.push(assistantMessage);
      persistState();

      if (cancelRequested) {
        // Handled above: draft discarded, message displayed, no payload.
      } else if (payload && payload.files.length) {
        const files = payload.files.filter(
          (file): file is { path: string; content: string } =>
            typeof file === 'object' &&
            file !== null &&
            typeof (file as { path?: unknown }).path === 'string' &&
            typeof (file as { content?: unknown }).content === 'string',
        );
        if (files.length) {
          const generated = {
            title: payload.title || 'Generated content',
            summary: payload.summary || '',
            // Git-fallback images are committed alongside the generated files.
            files: [...files, ...gitImages.map((img) => gitImageFile(img))],
          };
          // Single source of truth: manual edits in the preview panel are
          // picked up from this shared state by the deploy stepper.
          state.payload = generated;
          persistState();
          emit('sc:payload', generated);
          toast(t(lang, 'chat.filesReady', files.length + gitImages.length), 'success');
          // Replace the raw JSON dump with a clean summary + payload note.
          const note = document.createElement('div');
          note.className = 'payload-note';
          note.textContent = t(lang, 'chat.payloadNote');
          bubble.innerHTML = renderMarkdown(payload.summary || '✅');
          bubble.appendChild(note);
          scrollBottom();
        } else {
          toast(t(lang, 'chat.invalidPayload'), 'error');
        }
      } else if (payload) {
        // JSON envelope without files → conversational reply, already displayed.
      } else if (!display || display === '(empty response)') {
        toast(t(lang, 'chat.noPayload'), 'info');
      } else {
        // Plain text without a structured payload: distinguish a truncated
        // response (output limit) from a genuinely unstructured reply.
        const note = document.createElement('div');
        note.className = 'payload-note payload-note-warn';
        note.textContent = isTruncated(display)
          ? t(lang, 'chat.truncatedNote')
          : state.payload?.files?.length
            ? t(lang, 'chat.noPayloadKeepDraft')
            : t(lang, 'chat.noPayloadNote');
        bubble.appendChild(note);
      }
    } catch (error) {
      console.error('[chat]', error);
      bubble.textContent = t(lang, 'chat.streamError');
    } finally {
      streaming = false;
      sendBtn.disabled = false;
      sendBtn.textContent = '↑';
      scrollBottom();
    }
  }

  /** Converts a Git-fallback image into a base64 payload file. */
  function gitImageFile(img: { path: string; dataUrl: string }): {
    path: string;
    content: string;
    base64: true;
  } {
    return {
      path: img.path,
      content: img.dataUrl.slice(img.dataUrl.indexOf(',') + 1),
      base64: true,
    };
  }

  // Once a draft PR has been created, the Git-fallback images are committed:
  // clear the pending list so the next generation does not duplicate them.
  on('sc:pr-created', () => {
    gitImages = [];
  });

  // Pending draft discarded (chat marker or the preview panel button) → the
  // Git-fallback images bound to it are discarded too.
  on('sc:payload-cleared', () => {
    gitImages = [];
  });

  // Session reset → back to the start state (chat + composer).
  on('sc:reset', () => {
    // Re-capture the shared state (defense in depth: `state` must always be
    // the current window.__sc object).
    state = getState();
    pendingImages = [];
    gitImages = [];
    inputEl.value = '';
    setInputExpanded(false, false);
    renderStrip();
    renderAll();
  });

  sendBtn.addEventListener('click', () => void send());
  inputEl.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      void send();
    }
  });

  // Auto-grow textarea (suspended while manually expanded)
  const expandBtn = document.getElementById('btn-expand') as HTMLButtonElement;
  let inputExpanded = false;

  function setInputExpanded(expanded: boolean, focus = true) {
    inputExpanded = expanded;
    if (expanded) {
      // Large fixed-height editor; the resize handle allows fine-tuning.
      inputEl.classList.add('expanded');
      inputEl.style.height = `${Math.min(window.innerHeight * 0.5, 420)}px`;
    } else {
      inputEl.classList.remove('expanded');
      inputEl.style.height = 'auto';
      inputEl.style.height = `${Math.min(inputEl.scrollHeight, 160)}px`;
    }
    expandBtn.textContent = expanded ? '⤡' : '⤢';
    expandBtn.title = t(lang, expanded ? 'chat.collapseInput' : 'chat.expandInput');
    expandBtn.setAttribute('aria-label', expandBtn.title);
    if (focus) inputEl.focus();
  }

  expandBtn.addEventListener('click', () => setInputExpanded(!inputExpanded));

  inputEl.addEventListener('input', () => {
    if (inputExpanded) return;
    inputEl.style.height = 'auto';
    inputEl.style.height = `${Math.min(inputEl.scrollHeight, 160)}px`;
  });

  renderAll();
</script>
