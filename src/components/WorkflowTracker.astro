---
import { t } from '../i18n';

interface Props {
  siteId: string;
  siteName: string;
  branch: string;
}

const { siteId, siteName, branch } = Astro.props;
const { lang } = Astro.locals;
---

<div class="workspace-panel panel-workflow" data-site-id={siteId}>
  <div class="panel-header">
    <div>
      <h2>{t(lang, 'workflow.title')} — {siteName}</h2>
      <span class="panel-sub">{t(lang, 'workflow.sub')}</span>
    </div>
  </div>

  <ol class="stepper" id="stepper">
    <!-- Étape 1 : Pré-visualisation -->
    <li class="step" data-step="1">
      <span class="step-num">1</span>
      <div class="step-content">
        <div class="step-head">{t(lang, 'workflow.step1')}</div>
        <div class="step-body">
          <button class="btn btn-primary btn-lg" type="button" id="btn-create-pr" disabled>
            {t(lang, 'workflow.createPreview')}
          </button>
          <label class="auto-preview-toggle" title={t(lang, 'workflow.autoPreviewTitle')}>
            <input type="checkbox" id="auto-preview" checked />
            <span>⚡ {t(lang, 'workflow.autoPreview')}</span>
          </label>
          <p class="auto-preview-note" id="auto-preview-note" hidden>
            {t(lang, 'workflow.autoPreviewNote')}
          </p>
          <span class="step-hint" id="preview-hint">{t(lang, 'workflow.step1Hint')}</span>
          <a class="preview-link" id="preview-link" href="#" target="_blank" rel="noopener noreferrer" hidden>
            {t(lang, 'workflow.viewPreview')}
          </a>
          <div class="preview-pages" id="preview-pages" hidden>
            <div class="preview-pages-title">{t(lang, 'workflow.pagesTitle')}</div>
            <ul class="preview-pages-list" id="preview-pages-list"></ul>
          </div>
          <button class="btn btn-ghost" type="button" id="btn-cancel" hidden>
            {t(lang, 'workflow.cancel')}
          </button>
          <details class="tech-details">
            <summary>{t(lang, 'workflow.techDetails')}</summary>
            <p id="pr-tech">
              <a id="pr-link" href="#" target="_blank" rel="noopener noreferrer" hidden></a>
              <span class="tech-branch" id="pr-branch" hidden></span>
            </p>
            <p class="tech-line" id="pr-status-tech"></p>
            <p>
              <a id="build-link" href="#" target="_blank" rel="noopener noreferrer" hidden>
                {t(lang, 'workflow.viewBuild')}
              </a>
            </p>
          </details>
        </div>
      </div>
    </li>

    <!-- Étape 2 : Validation & déploiement -->
    <li class="step" data-step="2">
      <span class="step-num">2</span>
      <div class="step-content">
        <div class="step-head">{t(lang, 'workflow.step2')}</div>
        <div class="step-body">
          <button class="btn btn-success btn-lg" type="button" id="btn-merge" disabled>
            {t(lang, 'workflow.merge')}
          </button>
          <p class="publish-note">{t(lang, 'workflow.mergeNote')}</p>
          <a class="preview-link" id="prod-link" href="#" target="_blank" rel="noopener noreferrer" hidden>
            {t(lang, 'workflow.viewSite')}
          </a>
          <span class="step-hint">{t(lang, 'workflow.step2Hint')}</span>
          <details class="tech-details">
            <summary>{t(lang, 'workflow.techDetails')}</summary>
            <p class="tech-line">
              Base : <code>{branch}</code> · {t(lang, 'workflow.step4Hint')}
            </p>
          </details>
        </div>
      </div>
    </li>
  </ol>
</div>

<script>
  import { getState, on, persistState, switchToWorkspaceTab, toast } from '../lib/client-state';
  import type { WorkflowState } from '../lib/client-state';
  import { getClientLocale, t } from '../i18n';

  const lang = getClientLocale();
  // Site id is passed via a data attribute (frontmatter variables are not
  // interpolated inside Astro <script> blocks).
  const siteId =
    document.querySelector<HTMLElement>('[data-site-id]')?.dataset.siteId ?? '';
  const state = getState();

  // URLs come from GitHub (repos/PRs) → only allow http(s).
  function safeHttpUrl(value: string): string {
    return /^https?:\/\//i.test(value) ? value : '#';
  }

  const btnCreate = document.getElementById('btn-create-pr') as HTMLButtonElement;
  const btnCancel = document.getElementById('btn-cancel') as HTMLButtonElement;
  const previewHint = document.getElementById('preview-hint') as HTMLElement;
  const previewLink = document.getElementById('preview-link') as HTMLAnchorElement;
  const pagesEl = document.getElementById('preview-pages') as HTMLElement;
  const pagesList = document.getElementById('preview-pages-list') as HTMLUListElement;
  const prLink = document.getElementById('pr-link') as HTMLAnchorElement;
  const prBranch = document.getElementById('pr-branch') as HTMLElement;
  const prStatusTech = document.getElementById('pr-status-tech') as HTMLElement;
  const buildLink = document.getElementById('build-link') as HTMLAnchorElement;
  const btnMerge = document.getElementById('btn-merge') as HTMLButtonElement;
  const prodLink = document.getElementById('prod-link') as HTMLAnchorElement;

  let polling: ReturnType<typeof setInterval> | null = null;
  let pollingStarted = false;
  let polls = 0;
  // Post-merge tracking: polls since the merge, to bound the wait for the
  // production deploy (quality checks + deploy on main).
  let mergePolls = 0;
  // Direct links to the modified pages (from frontmatter permalinks), built
  // once the preview base URL is known.
  let pageLinks: { path: string; url: string; title: string }[] = [];
  let previewBase: string | null = null;
  // ⚡ Auto-preview: create the preview build as soon as a new draft is
  // generated (per-browser preference, ON by default).
  const autoPreviewInput = document.getElementById('auto-preview') as HTMLInputElement;
  const autoPreviewNote = document.getElementById('auto-preview-note') as HTMLElement;
  const AUTO_PREVIEW_KEY = 'sc:auto-preview';

  function isAutoPreviewEnabled(): boolean {
    try {
      return localStorage.getItem(AUTO_PREVIEW_KEY) !== 'false';
    } catch {
      return true;
    }
  }

  function syncAutoPreviewUi() {
    autoPreviewInput.checked = isAutoPreviewEnabled();
    autoPreviewNote.hidden = !autoPreviewInput.checked;
  }

  syncAutoPreviewUi();
  autoPreviewInput.addEventListener('change', () => {
    try {
      localStorage.setItem(AUTO_PREVIEW_KEY, autoPreviewInput.checked ? 'true' : 'false');
    } catch {
      // ignore
    }
    autoPreviewNote.hidden = !autoPreviewInput.checked;
  });

  function activateStep(step: number, done = false) {
    for (let i = 1; i <= 2; i++) {
      const li = document.querySelector(`[data-step="${i}"]`);
      li?.classList.toggle('active', i === step && !done);
      li?.classList.toggle('done', i < step || (i === step && done));
    }
  }

  function resetStepper() {
    for (let i = 1; i <= 2; i++) {
      document.querySelector(`[data-step="${i}"]`)?.classList.remove('active', 'done');
    }
  }

  /** Extracts the page URL + title from a file's frontmatter (permalink). */
  function pageMetaFromContent(content: string): { url: string; title: string } | null {
    const permalink = content.match(/^permalink:\s*["']?([^"'\n]+)["']?\s*$/m);
    if (!permalink) return null;
    const url = permalink[1].trim();
    // Templated permalinks ({{ … }} / {% … %}) can't be resolved client-side.
    if (url.includes('{{') || url.includes('{%')) return null;
    const title = content.match(/^title:\s*["']?([^"'\n]+)["']?\s*$/m);
    return { url, title: title ? title[1].trim() : url };
  }

  /** Recomputes the direct page links from the current draft payload. */
  function computePageLinks() {
    const payload = getState().payload;
    pageLinks = [];
    for (const file of payload?.files ?? []) {
      const meta = pageMetaFromContent(file.content);
      if (meta) pageLinks.push({ path: file.path, ...meta });
    }
    // Keep the rendered list in sync if the preview is already available.
    if (previewBase) renderPageLinks(previewBase);
  }

  /** Joins the preview base URL with a page permalink. */
  function joinUrl(base: string, path: string): string {
    if (/^https?:\/\//i.test(path)) return path;
    return base.replace(/\/$/, '') + (path.startsWith('/') ? path : '/' + path);
  }

  /** Renders the list of directly-linked pages (multi-page drafts only). */
  function renderPageLinks(base: string) {
    pagesList.innerHTML = '';
    if (pageLinks.length <= 1) {
      pagesEl.hidden = true;
      return;
    }
    for (const link of pageLinks) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = safeHttpUrl(joinUrl(base, link.url));
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      const label = document.createElement('span');
      label.className = 'preview-pages-label';
      label.textContent = `${link.title} ↗`;
      const path = document.createElement('span');
      path.className = 'preview-pages-url';
      path.textContent = link.url;
      a.append(label, path);
      li.appendChild(a);
      pagesList.appendChild(li);
    }
    pagesEl.hidden = false;
  }

  // New payload generated → ready for step 1
  on('sc:payload', () => {
    computePageLinks();
    prodLink.hidden = true; // back to draft mode — the site link is stale
    btnCreate.disabled = false;
    if (!state.workflow) {
      resetStepper();
      previewLink.hidden = true;
      prLink.hidden = true;
      prBranch.hidden = true;
      prStatusTech.textContent = '';
      buildLink.hidden = true;
      btnMerge.disabled = true;
      btnCancel.hidden = true;
    }
    previewHint.textContent = t(lang, 'workflow.toastPayloadReady');
    // ⚡ Auto-preview: start the build right away so it is ready by the time
    // the client finishes reviewing the content in « Fichiers concernés ».
    if (isAutoPreviewEnabled()) {
      toast(t(lang, 'workflow.autoPreviewStarted'), 'info');
      void createPreview(true);
    } else {
      toast(t(lang, 'workflow.toastPayloadReady'), 'info');
    }
  });

  // Pending draft discarded (chat marker or the discard button) → nothing
  // left to preview. An open PR (if any) stays tracked and can be cancelled
  // or merged from the stepper.
  on('sc:payload-cleared', () => {
    btnCreate.disabled = true;
    pageLinks = [];
    prodLink.hidden = true;
    pagesEl.hidden = true;
    pagesList.innerHTML = '';
    if (!state.workflow) {
      previewHint.textContent = t(lang, 'workflow.step1Hint');
    }
  });

  let creatingPreview = false;

  /** Creates the draft PR + preview build from the shared payload. */
  async function createPreview(auto = false) {
    if (creatingPreview) return;
    // Read the SHARED payload at click/trigger time so manual edits made in
    // the preview panel are included in the draft PR.
    const current = getState().payload;
    if (!current || !current.files.length) return;
    creatingPreview = true;
    btnCreate.disabled = true;
    btnCreate.textContent = t(lang, 'workflow.creating');
    previewHint.textContent = auto
      ? t(lang, 'workflow.autoPreviewStarted')
      : t(lang, 'workflow.previewPending');

    try {
      const res = await fetch('/api/commit-draft', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          files: current.files,
          title: current.title,
          summary: current.summary,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? `Error ${res.status}`);

      const latestPayload = getState().payload;
      // Draft discarded while the PR was being created → cancel the orphan
      // preview instead of surfacing it.
      if (!latestPayload?.files?.length) {
        await fetch('/api/cancel-preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ prNumber: data.prNumber }),
        }).catch(() => undefined);
        return;
      }
      // Draft replaced while creating → the stale PR is left to the re-trigger
      // (finally) which creates the right preview; don't surface this one.
      if (latestPayload === current) {
        state.workflow = {
          siteId,
          prNumber: data.prNumber,
          prUrl: data.prUrl,
          branch: data.branch,
        } satisfies WorkflowState;
        persistState();

        // Let the chat clear its pending Git-fallback images (now committed).
        window.dispatchEvent(new CustomEvent('sc:pr-created'));

        activateStep(1);
        btnCancel.hidden = false;
        // Technical details (small print): PR link + branch
        prLink.href = safeHttpUrl(data.prUrl);
        prLink.textContent = t(lang, 'workflow.techPrLink', data.prNumber);
        prLink.hidden = false;
        prBranch.textContent = data.branch;
        prBranch.hidden = false;
        toast(t(lang, 'workflow.toastPrCreated', data.prNumber), 'success');
        switchToWorkspaceTab();
        startPolling();
      }
    } catch (error) {
      console.error('[workflow]', error);
      toast(error instanceof Error ? error.message : t(lang, 'workflow.toastCreateFailed'), 'error');
      btnCreate.disabled = false;
      btnCreate.textContent = t(lang, 'workflow.createPreview');
    } finally {
      creatingPreview = false;
      // A newer draft arrived while this preview was being created → start its
      // preview too (the flag just cleared prevents runaway loops).
      const latest = getState().payload;
      if (latest && latest !== current && latest.files?.length && isAutoPreviewEnabled()) {
        void createPreview(true);
      }
    }
  }

  btnCreate.addEventListener('click', () => void createPreview());

  // Refresh support: restore an open workflow (PR link + polling resumes).
  (function restoreWorkflow() {
    const workflow = state.workflow;
    if (!workflow) return;
    computePageLinks();
    btnCreate.disabled = true;
    btnCancel.hidden = false;
    activateStep(2);
    prLink.href = safeHttpUrl(workflow.prUrl);
    prLink.textContent = t(lang, 'workflow.prLink', workflow.prNumber, workflow.branch);
    prLink.hidden = false;
    prBranch.textContent = workflow.branch;
    prBranch.hidden = false;
    previewHint.textContent = t(lang, 'workflow.previewPending');
    startPolling();
  })();

  function startPolling() {
    const workflow = state.workflow;
    if (!workflow) return;
    if (pollingStarted) return;
    pollingStarted = true;

    polling = setInterval(async () => {
      try {
        const res = await fetch(`/api/status/${workflow.siteId}/${workflow.prNumber}`);
        const status = await res.json().catch(() => null);
        if (!res.ok || !status) {
          // Surface the real server error (diagnostic), then keep retrying.
          const detail = status?.error;
          prStatusTech.textContent = detail ?? t(lang, 'workflow.statusError');
          return;
        }

        if (status.merged) {
          // Post-merge: track the production deploy (quality checks + deploy
          // on main) instead of declaring success at merge time.
          btnCancel.hidden = true;
          // The preview (draft branch) no longer exists once merged.
          previewLink.hidden = true;
          pagesEl.hidden = true;
          pagesList.innerHTML = '';
          if (status.prodState === 'success') {
            activateStep(2, true);
            btnMerge.disabled = true;
            btnMerge.textContent = t(lang, 'workflow.mergedDone');
            previewHint.textContent = t(lang, 'workflow.mergedNote', workflow.prNumber);
            // Point the user at the live site once the deploy succeeded.
            if (status.prodUrl) {
              prodLink.href = safeHttpUrl(status.prodUrl);
              prodLink.hidden = false;
            }
            stopPolling();
            toast(t(lang, 'workflow.toastMerged'), 'success');
            return;
          }
          if (status.prodState === 'error') {
            activateStep(2, true);
            btnMerge.disabled = true;
            btnMerge.textContent = t(lang, 'workflow.publishFailed');
            previewHint.textContent = t(lang, 'workflow.mergedFailedNote');
            prodLink.hidden = true;
            stopPolling();
            toast(t(lang, 'workflow.mergedFailed'), 'error');
            return;
          }
          // pending / in_progress / unknown → keep polling, bounded.
          mergePolls++;
          if (mergePolls > 75) {
            // ~5 min at 4s — stop and let the user verify on GitHub.
            btnMerge.disabled = true;
            btnMerge.textContent = t(lang, 'workflow.mergeAwaiting');
            previewHint.textContent = t(lang, 'workflow.mergeAwaitingNote');
            stopPolling();
            return;
          }
          activateStep(2);
          btnMerge.disabled = true;
          btnMerge.textContent = t(lang, 'workflow.merging');
          previewHint.textContent =
            status.prodState === 'in_progress'
              ? t(lang, 'workflow.publishingInProgress')
              : t(lang, 'workflow.publishingPending');
          return;
        }

        if (status.previewUrl) {
          activateStep(2);
          previewBase = safeHttpUrl(status.previewUrl).replace(/\/$/, '');
          // Single modified page → the preview link goes straight to it.
          previewLink.href =
            pageLinks.length === 1
              ? safeHttpUrl(joinUrl(previewBase, pageLinks[0].url))
              : previewBase;
          previewLink.hidden = false;
          previewHint.textContent =
            pageLinks.length === 1
              ? `${t(lang, 'workflow.previewReady')} — ${pageLinks[0].title}`
              : t(lang, 'workflow.previewReady');
          prStatusTech.textContent = '';
          btnMerge.disabled = false;
          stopPolling();
          renderPageLinks(previewBase);
          toast(t(lang, 'workflow.toastPreviewReady'), 'success');
          return;
        }

        if (status.state === 'error') {
          previewHint.textContent = t(lang, 'workflow.previewFailed');
          prStatusTech.textContent = t(lang, 'workflow.previewFailed');
          if (status.buildUrl) {
            buildLink.href = safeHttpUrl(status.buildUrl);
            buildLink.hidden = false;
          }
          stopPolling();
          return;
        }

        polls++;
        previewHint.textContent =
          polls > 5
            ? t(lang, 'workflow.noPreviewHint')
            : status.state === 'in_progress'
              ? t(lang, 'workflow.previewBuilding')
              : t(lang, 'workflow.previewPending');
      } catch (error) {
        console.error('[polling]', error);
        prStatusTech.textContent = t(lang, 'workflow.statusError');
      }
    }, 4000);
  }

  function stopPolling() {
    if (polling) clearInterval(polling);
    polling = null;
    pollingStarted = false;
  }

  // Session reset → back to the start state (stepper cleared).
  on('sc:reset', () => {
    resetStepper();
    stopPolling();
    pageLinks = [];
    previewBase = null;
    mergePolls = 0;
    prodLink.hidden = true;
    pagesEl.hidden = true;
    pagesList.innerHTML = '';
    btnCreate.disabled = true;
    btnCreate.textContent = t(lang, 'workflow.createPreview');
    previewHint.textContent = t(lang, 'workflow.step1Hint');
    previewLink.hidden = true;
    prLink.hidden = true;
    prBranch.hidden = true;
    prStatusTech.textContent = '';
    buildLink.hidden = true;
    btnMerge.disabled = true;
    btnCancel.hidden = true;
    btnCancel.disabled = false;
    btnCancel.textContent = t(lang, 'workflow.cancel');
  });

  // Explicit "cancel preview": close the draft PR + delete its branch,
  // WITHOUT merging. The generated payload stays ready (can be re-previewed
  // or regenerated).
  btnCancel.addEventListener('click', async () => {
    const workflow = state.workflow;
    if (!workflow) return;
    if (!window.confirm(t(lang, 'workflow.cancelConfirm', workflow.prNumber))) return;
    btnCancel.disabled = true;
    btnCancel.textContent = t(lang, 'workflow.cancelling');
    try {
      const res = await fetch('/api/cancel-preview', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ prNumber: workflow.prNumber }),
      });
      const data = await res.json();
      if (!res.ok || !data.closed) throw new Error(data.error ?? 'Cancel failed');

      state.workflow = null;
      persistState();
      stopPolling();
      resetStepper();
      previewBase = null;
      prodLink.hidden = true;
      pagesEl.hidden = true;
      pagesList.innerHTML = '';
      previewLink.hidden = true;
      prLink.hidden = true;
      prBranch.hidden = true;
      prStatusTech.textContent = '';
      buildLink.hidden = true;
      btnMerge.disabled = true;
      btnCancel.hidden = true;
      btnCancel.disabled = false;
      btnCancel.textContent = t(lang, 'workflow.cancel');
      // Re-create the preview only if a draft still exists (it may have been
      // discarded in the meantime).
      const hasDraft = Boolean(getState().payload?.files?.length);
      btnCreate.disabled = !hasDraft;
      btnCreate.textContent = t(lang, 'workflow.createPreview');
      previewHint.textContent = hasDraft
        ? t(lang, 'workflow.toastPayloadReady')
        : t(lang, 'workflow.step1Hint');
      toast(t(lang, 'workflow.cancelDone', workflow.prNumber), 'success');
    } catch (error) {
      console.error('[workflow]', error);
      toast(error instanceof Error ? error.message : t(lang, 'workflow.cancelFailed'), 'error');
      btnCancel.disabled = false;
      btnCancel.textContent = t(lang, 'workflow.cancel');
    }
  });

  btnMerge.addEventListener('click', async () => {
    const workflow = state.workflow;
    if (!workflow) return;
    btnMerge.disabled = true;
    btnMerge.textContent = t(lang, 'workflow.merging');
    try {
      const res = await fetch('/api/merge', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ prNumber: workflow.prNumber }),
      });
      const data = await res.json();
      if (!res.ok || !data.merged) throw new Error(data.message ?? data.error ?? 'Merge refused');

      // The PR is merged — resume polling to track the production deploy
      // (quality checks + deploy on main) until it succeeds or fails.
      mergePolls = 0;
      activateStep(2);
      btnMerge.disabled = true;
      btnMerge.textContent = t(lang, 'workflow.merging');
      previewHint.textContent = t(lang, 'workflow.publishingPending');
      startPolling();
    } catch (error) {
      console.error('[merge]', error);
      toast(error instanceof Error ? error.message : t(lang, 'workflow.toastMergeFailed'), 'error');
      btnMerge.disabled = false;
      btnMerge.textContent = t(lang, 'workflow.merge');
    }
  });
</script>
