---
import { t } from '../i18n';

const { lang } = Astro.locals;
---

<div class="workspace-panel panel-preview">
  <div class="panel-header">
    <div>
      <h2>{t(lang, 'preview.title')}</h2>
      <span class="panel-sub" id="preview-meta">{t(lang, 'preview.empty')}</span>
    </div>
    <div class="panel-actions">
      <button class="btn btn-ghost btn-sm" type="button" id="btn-discard-draft" hidden>
        {t(lang, 'preview.discard')}
      </button>
      <div class="seg" id="view-toggle" role="tablist" aria-label="View mode">
        <button type="button" role="tab" data-view="visual" class="active" aria-selected="true">
          {t(lang, 'preview.visual')}
        </button>
        <button type="button" role="tab" data-view="code" aria-selected="false">
          {t(lang, 'preview.code')}
        </button>
        <button type="button" role="tab" data-view="diff" aria-selected="false">
          {t(lang, 'preview.diff')}
        </button>
      </div>
    </div>
  </div>

  <div class="empty-state" id="preview-empty">
    <span class="empty-icon">🗂️</span>
    <p>{t(lang, 'preview.emptyDetail')}</p>
  </div>

  <div class="preview-root" id="preview-root" hidden>
    <div class="file-tabs" id="file-tabs" role="tablist" aria-label="Files"></div>
    <div class="file-toolbar" id="file-toolbar">
      <button class="btn btn-ghost btn-sm" type="button" id="btn-copy">📋 {t(lang, 'preview.copy')}</button>
      <button class="btn btn-ghost btn-sm" type="button" id="btn-download">⬇️ {t(lang, 'preview.download')}</button>
      <button class="btn btn-ghost btn-sm" type="button" id="btn-edit">✏️ {t(lang, 'preview.edit')}</button>
      <button class="btn btn-primary btn-sm" type="button" id="btn-save" hidden>💾 {t(lang, 'preview.save')}</button>
      <button class="btn btn-ghost btn-sm" type="button" id="btn-cancel" hidden>{t(lang, 'preview.cancel')}</button>
      <span class="badge badge-warning" id="edit-modified" hidden>{t(lang, 'preview.modified')}</span>
      <span class="file-path" id="file-path"></span>
    </div>
    <div class="file-view" id="file-view"></div>
    <textarea class="file-editor" id="file-editor" spellcheck="false" hidden></textarea>
    <p class="editor-hint" id="editor-hint" hidden></p>
  </div>
</div>

<script>
  import { emit, getState, on, persistState, toast } from '../lib/client-state';
  import type { PayloadFile } from '../lib/client-state';
  import { getClientLocale, t } from '../i18n';
  import { renderJson, renderMarkdown } from '../lib/markdown-lite';

  const lang = getClientLocale();

  // MIME type per image extension (Git-fallback base64 preview).
  const EXT_MIME: Record<string, string> = {
    webp: 'image/webp',
    png: 'image/png',
    jpg: 'image/jpeg',
    jpeg: 'image/jpeg',
    gif: 'image/gif',
    avif: 'image/avif',
  };
  const isImageFile = (path: string) => /^public\/images\//i.test(path);
  const imageMime = (path: string) => {
    const ext = path.split('.').pop()?.toLowerCase() ?? '';
    return EXT_MIME[ext] ?? 'image/webp';
  };

  const state = getState();
  const emptyEl = document.getElementById('preview-empty') as HTMLElement;
  const rootEl = document.getElementById('preview-root') as HTMLElement;
  const tabsEl = document.getElementById('file-tabs') as HTMLElement;
  const viewEl = document.getElementById('file-view') as HTMLElement;
  const editorEl = document.getElementById('file-editor') as HTMLTextAreaElement;
  const editorHint = document.getElementById('editor-hint') as HTMLElement;
  const metaEl = document.getElementById('preview-meta') as HTMLElement;
  const pathEl = document.getElementById('file-path') as HTMLElement;
  const toolbarEl = document.getElementById('file-toolbar') as HTMLElement;
  const copyBtn = document.getElementById('btn-copy') as HTMLButtonElement;
  const downloadBtn = document.getElementById('btn-download') as HTMLButtonElement;
  const editBtn = document.getElementById('btn-edit') as HTMLButtonElement;
  const saveBtn = document.getElementById('btn-save') as HTMLButtonElement;
  const cancelBtn = document.getElementById('btn-cancel') as HTMLButtonElement;
  const modifiedBadge = document.getElementById('edit-modified') as HTMLElement;
  const discardBtn = document.getElementById('btn-discard-draft') as HTMLButtonElement;

  let files: PayloadFile[] = [];
  let active = 0;
  let viewMode: 'visual' | 'code' | 'diff' = 'visual';
  let editing = false;
  // A new file starts CLOSED (no raw code shown) until the user opens it.
  const opened = new Set<string>();
  // Once the user picks a view tab, respect it; otherwise use smart defaults
  // (diff for modified files, visual for opened new files).
  let userChoseView = false;

  // Base for the Diff view: repo original (existing files) or the snapshot
  // taken before the first manual edit (new files).
  const diffBaseOf = (file: PayloadFile): string | undefined =>
    file.original ?? file.diffBase;
  const canDiff = (file: PayloadFile): boolean => Boolean(diffBaseOf(file));

  function effectiveViewFor(file: PayloadFile): 'visual' | 'code' | 'diff' {
    if (userChoseView) return viewMode;
    return canDiff(file) ? 'diff' : 'visual';
  }

  function syncViewToggle(mode: 'visual' | 'code' | 'diff') {
    document.querySelectorAll('#view-toggle [data-view]').forEach((el) => {
      const activeTab = el.getAttribute('data-view') === mode;
      el.classList.toggle('active', activeTab);
      el.setAttribute('aria-selected', String(activeTab));
    });
  }

  const isMarkdown = (path: string) => /\.(md|mdx|markdown)$/i.test(path);
  const isJson = (path: string) => /\.json$/i.test(path);
  const iconFor = (path: string) => (isMarkdown(path) ? '📝' : isJson(path) ? '⚙️' : '📄');

  /** Page context (title + permalink) from a file's frontmatter. */
  function pageMeta(content: string): { title: string; permalink: string } | null {
    const permalink = content.match(/^permalink:\s*["']?([^"'\n]+)["']?\s*$/m);
    if (!permalink) return null;
    const title = content.match(/^title:\s*["']?([^"'\n]+)["']?\s*$/m);
    return { title: title ? title[1].trim() : '', permalink: permalink[1].trim() };
  }

  on('sc:payload', (payload: { files?: PayloadFile[]; title?: string; summary?: string }) => {
    if (!Array.isArray(payload.files) || !payload.files.length) return;
    // Single source of truth: the shared state (edited files are picked up
    // by the deploy stepper when creating the preview PR).
    state.payload = {
      title: payload.title ?? '',
      summary: payload.summary ?? '',
      files: payload.files,
    };
    files = payload.files;
    active = -1; // list only by default — content appears on file click
    opened.clear();
    userChoseView = false;
    exitEdit();
    renderTabs();
    renderFile();
    emptyEl.hidden = true;
    rootEl.hidden = false;
    discardBtn.hidden = false;
    const kb = (files.reduce((sum, file) => sum + file.content.length, 0) / 1024).toFixed(1);
    metaEl.textContent = t(lang, 'preview.meta', files.length, kb, payload.title ?? '');
  });

  function renderTabs() {
    tabsEl.innerHTML = '';
    files.forEach((file, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `file-tab${index === active ? ' active' : ''}`;
      button.setAttribute('role', 'tab');
      // Paths come from the AI payload → escaped before insertion
      const name = escapeHtml(file.path.split('/').pop() ?? file.path);
      const path = escapeHtml(file.path);
      button.innerHTML = `${iconFor(file.path)}<span>${name}</span><em>${path}</em>`;
      button.addEventListener('click', () => {
        active = index;
        exitEdit();
        renderTabs();
        renderFile();
      });
      tabsEl.appendChild(button);
    });
  }

  function renderFile() {
    const file = files[active];
    // Default state: list only — no file selected → no content, no toolbar.
    // (The studio targets non-technical users: details appear on click.)
    if (!file) {
      pathEl.textContent = '';
      toolbarEl.hidden = true;
      viewEl.hidden = false;
      viewEl.innerHTML = `<div class="file-closed">
        <span class="empty-icon">📂</span>
        <p>${t(lang, 'preview.selectFile')}</p>
      </div>`;
      syncViewToggle('visual');
      return;
    }
    toolbarEl.hidden = false;
    pathEl.textContent = file.path;
    updateDiffToggle(file);

    // New file, not opened yet → friendly state (no raw code shown).
    if (!diffBaseOf(file) && !opened.has(file.path)) {
      viewEl.innerHTML = `<div class="file-closed">
        <span class="empty-icon">📄</span>
        <p>${t(lang, 'preview.newFile')}</p>
        <button type="button" class="btn btn-primary" id="btn-open-file">${t(lang, 'preview.open')}</button>
      </div>`;
      document.getElementById('btn-open-file')?.addEventListener('click', () => {
        opened.add(file.path);
        renderFile();
      });
      syncViewToggle('visual');
      return;
    }

    const mode = effectiveViewFor(file);
    syncViewToggle(mode);
    if (mode === 'diff') {
      renderDiff(file);
      return;
    }

    // Git-fallback image: preview the base64 content directly.
    if (file.base64 && isImageFile(file.path)) {
      viewEl.innerHTML = `<figure class="md-figure"><img src="data:${imageMime(file.path)};base64,${file.content}" alt="${escapeHtml(file.path)}" /><figcaption>${escapeHtml(file.path)}</figcaption></figure>`;
      return;
    }

    if (mode === 'code') {
      if (isJson(file.path)) {
        viewEl.innerHTML = `<pre class="code-fence"><code>${renderJson(file.content).html}</code></pre>`;
      } else {
        viewEl.innerHTML = `<pre class="code-fence"><code>${escapeHtml(file.content)}</code></pre>`;
      }
      return;
    }

    // Visual view — the modified page rendered in its context (title + URL)
    // for an instant content review without waiting for the CI build.
    if (isMarkdown(file.path)) {
      const meta = pageMeta(file.content);
      const header = meta
        ? `<div class="page-preview-header">
             <span class="page-preview-title">${escapeHtml(meta.title || 'Page')}</span>
             <span class="page-preview-url">${escapeHtml(meta.permalink)}</span>
           </div>`
        : '';
      viewEl.innerHTML = header + `<article class="md-preview">${renderMarkdown(file.content)}</article>`;
    } else if (isJson(file.path)) {
      viewEl.innerHTML = `<pre class="code-fence"><code>${renderJson(file.content).html}</code></pre>`;
    } else {
      viewEl.innerHTML = `<pre class="code-fence"><code>${escapeHtml(file.content)}</code></pre>`;
    }
  }

  function escapeHtml(src: string): string {
    return src.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // ── Diff view ────────────────────────────────────────────────────
  interface DiffLine {
    type: 'add' | 'del';
    oldLine: number | null;
    newLine: number | null;
    text: string;
  }

  /** Line diff (LCS): returns ONLY the changed lines, grouped into hunks. */
  function diffLines(a: string, b: string): DiffLine[][] {
    const A = a.split('\n');
    const B = b.split('\n');
    const n = A.length;
    const m = B.length;

    const dp: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0));
    for (let i = n - 1; i >= 0; i--) {
      for (let j = m - 1; j >= 0; j--) {
        dp[i][j] = A[i] === B[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
      }
    }

    // Group changes into hunks: a new hunk starts when unchanged lines were
    // skipped between changes (a replace = del+add stays in ONE hunk).
    const hunks: DiffLine[][] = [];
    let gap = true;
    const push = (line: DiffLine) => {
      if (gap || !hunks.length) hunks.push([line]);
      else hunks[hunks.length - 1].push(line);
      gap = false;
    };

    let i = 0;
    let j = 0;
    while (i < n && j < m) {
      if (A[i] === B[j]) {
        i++;
        j++;
        gap = true;
      } else if (dp[i + 1][j] >= dp[i][j + 1]) {
        push({ type: 'del', oldLine: i + 1, newLine: null, text: A[i] });
        i++;
      } else {
        push({ type: 'add', oldLine: null, newLine: j + 1, text: B[j] });
        j++;
      }
    }
    while (i < n) push({ type: 'del', oldLine: i + 1, newLine: null, text: A[i++] });
    while (j < m) push({ type: 'add', oldLine: null, newLine: j + 1, text: B[j++] });

    return hunks;
  }

  function updateDiffToggle(file: PayloadFile) {
    const btn = document.querySelector('[data-view="diff"]') as HTMLButtonElement | null;
    if (!btn) return;
    const disabled = !canDiff(file);
    btn.disabled = disabled;
    if (disabled && viewMode === 'diff') {
      viewMode = 'visual';
      document.querySelector('[data-view="visual"]')?.classList.add('active');
      btn.classList.remove('active');
      document.querySelector('[data-view="visual"]')?.setAttribute('aria-selected', 'true');
      btn.setAttribute('aria-selected', 'false');
    }
  }

  function renderDiff(file: PayloadFile) {
    const base = diffBaseOf(file);
    if (base === undefined || base === file.content) {
      viewEl.innerHTML = `<p class="diff-empty">${t(lang, 'preview.diffEmpty')}</p>`;
      return;
    }
    const hunks = diffLines(base, file.content);
    if (!hunks.length) {
      viewEl.innerHTML = `<p class="diff-empty">${t(lang, 'preview.diffEmpty')}</p>`;
      return;
    }
    viewEl.innerHTML =
      `<div class="diff-view">` +
      hunks
        .map(
          (hunk) =>
            `<div class="diff-hunk">` +
            hunk
              .map((line) => {
                const num = line.type === 'add' ? line.newLine : line.oldLine;
                const sign = line.type === 'add' ? '+' : '-';
                return `<div class="diff-line diff-${line.type}"><span class="diff-num">${num ?? ''}</span><span class="diff-sign">${sign}</span><code>${escapeHtml(line.text) || ' '}</code></div>`;
              })
              .join('') +
            `</div>`,
        )
        .join('<div class="diff-sep">⋯</div>') +
      `</div>`;
  }

  // Back to the start state (empty panel).
  function resetPanel() {
    files = [];
    active = -1;
    opened.clear();
    userChoseView = false;
    exitEdit();
    emptyEl.hidden = false;
    rootEl.hidden = true;
    metaEl.textContent = t(lang, 'preview.empty');
    discardBtn.hidden = true;
  }

  // Session reset → back to the start state (chat + draft).
  on('sc:reset', resetPanel);

  // Pending draft discarded (chat marker or the discard button) → empty panel.
  on('sc:payload-cleared', resetPanel);

  // Manual discard: clears the local draft. An open preview PR must be
  // cancelled from the stepper first (it would otherwise become untracked).
  discardBtn.addEventListener('click', () => {
    const current = getState();
    if (current.workflow) {
      toast(t(lang, 'preview.discardPrActive'), 'error');
      return;
    }
    if (!window.confirm(t(lang, 'preview.discardConfirm'))) return;
    current.payload = null;
    persistState();
    emit('sc:payload-cleared', null);
    toast(t(lang, 'preview.discardDone'), 'success');
  });

  // ── Manual editing (PagesCMS-style) ──────────────────────────────
  function exitEdit() {
    editing = false;
    editorEl.hidden = true;
    editorHint.hidden = true;
    viewEl.hidden = false;
    editBtn.hidden = false;
    saveBtn.hidden = true;
    cancelBtn.hidden = true;
    renderModifiedBadge();
  }

  function renderModifiedBadge() {
    const file = files[active];
    modifiedBadge.hidden = !(file && file.modified);
  }

  editBtn.addEventListener('click', () => {
    const file = files[active];
    if (!file || (file.base64 && isImageFile(file.path))) return;
    // Snapshot the pre-edit content so the Diff stays meaningful after saving.
    if (!file.original && !file.diffBase) file.diffBase = file.content;
    editing = true;
    editorEl.value = file.content;
    editorEl.hidden = false;
    viewEl.hidden = true;
    editBtn.hidden = true;
    saveBtn.hidden = false;
    cancelBtn.hidden = false;
    editorHint.hidden = false;
    editorHint.textContent = t(lang, 'preview.editorHint');
    editorEl.focus();
  });

  saveBtn.addEventListener('click', () => {
    const file = files[active];
    if (!file || !editing) return;
    file.content = editorEl.value;
    file.modified = true;
    // Keep the shared payload in sync (used by the deploy stepper).
    if (state.payload) state.payload.files[active] = file;
    persistState();
    exitEdit();
    syncViewToggle(effectiveViewFor(file));
    renderFile();
    window.dispatchEvent(
      new CustomEvent('sc:toast', { detail: { message: t(lang, 'preview.saved', file.path), type: 'success' } }),
    );
  });

  cancelBtn.addEventListener('click', exitEdit);

  // Tab → 2 spaces (essential for YAML/JSON), Ctrl/Cmd+S → save
  editorEl.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      event.preventDefault();
      const start = editorEl.selectionStart;
      const end = editorEl.selectionEnd;
      editorEl.value = editorEl.value.slice(0, start) + '  ' + editorEl.value.slice(end);
      editorEl.selectionStart = editorEl.selectionEnd = start + 2;
      return;
    }
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
      event.preventDefault();
      saveBtn.click();
    }
  });

  // Visual / code / diff toggle — opening a new file or picking a view
  document.getElementById('view-toggle')?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-view]');
    if (!button || button.disabled) return;
    const file = files[active];
    if (file && !diffBaseOf(file)) opened.add(file.path); // open new files
    const next = button.dataset.view === 'code' ? 'code' : button.dataset.view === 'diff' ? 'diff' : 'visual';
    if (next === 'diff' && file && !canDiff(file)) {
      window.dispatchEvent(
        new CustomEvent('sc:toast', { detail: { message: t(lang, 'preview.noDiff'), type: 'info' } }),
      );
      return;
    }
    viewMode = next;
    userChoseView = true;
    syncViewToggle(viewMode);
    exitEdit();
    renderFile();
  });

  copyBtn.addEventListener('click', async () => {
    const file = files[active];
    if (!file) return;
    try {
      await navigator.clipboard.writeText(file.content);
      window.dispatchEvent(
        new CustomEvent('sc:toast', { detail: { message: t(lang, 'preview.copied', file.path), type: 'success' } }),
      );
    } catch {
      window.dispatchEvent(
        new CustomEvent('sc:toast', { detail: { message: t(lang, 'preview.copyFailed'), type: 'error' } }),
      );
    }
  });

  downloadBtn.addEventListener('click', () => {
    const file = files[active];
    if (!file) return;
    const blob = new Blob([file.content], { type: 'text/plain;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = file.path.split('/').pop() ?? 'file.txt';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // Restore a persisted draft on page refresh — same rendering as a new
  // payload (list only, content on click). The chat history (ChatStudio) and
  // the stepper (WorkflowTracker) already restore on load; this keeps the
  // « Fichiers concernés » panel in sync with them.
  (function restorePayload() {
    const payload = state.payload;
    if (!payload || !Array.isArray(payload.files) || !payload.files.length) return;
    files = payload.files;
    active = -1;
    opened.clear();
    userChoseView = false;
    exitEdit();
    renderTabs();
    renderFile();
    emptyEl.hidden = true;
    rootEl.hidden = false;
    discardBtn.hidden = false;
    const kb = (files.reduce((sum, file) => sum + file.content.length, 0) / 1024).toFixed(1);
    metaEl.textContent = t(lang, 'preview.meta', files.length, kb, payload.title ?? '');
  })();
</script>
