---
import { t } from '../i18n';
import type { SiteConfig } from '../config/sites';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const { lang } = Astro.locals;
const siteName = site.name;
// Server-side storage state: does this site have a per-site R2 target?
// (Keys presence is resolved client-side after loadMasked.)
const r2Configured = Boolean(site.r2AccountId && site.r2Bucket);

const FIELDS = [
  {
    name: 'DEEPSEEK_API_KEY',
    labelKey: 'settings.fieldDeepseek',
    placeholderKey: 'settings.placeholderDeepseek',
    hintKey: 'settings.hintDeepseek',
  },
  {
    name: 'GITHUB_PAT',
    labelKey: 'settings.fieldGithub',
    placeholderKey: 'settings.placeholderGithub',
    hintKey: 'settings.hintGithub',
  },
  {
    name: 'R2_ACCESS_KEY_ID',
    labelKey: 'settings.fieldR2AccessKey',
    placeholderKey: 'settings.placeholderR2Key',
    hintKey: 'settings.hintR2AccessKey',
  },
  {
    name: 'R2_SECRET_ACCESS_KEY',
    labelKey: 'settings.fieldR2Secret',
    placeholderKey: 'settings.placeholderR2Key',
    hintKey: 'settings.hintR2Secret',
  },
] as const;

const GENERAL_FIELDS = FIELDS.slice(0, 2);
const R2_FIELDS = FIELDS.slice(2);
---

<div class="modal-backdrop" id="settings-modal" hidden data-r2-configured={String(r2Configured)}>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="settings-title">
    <div class="modal-header">
      <h2 id="settings-title">{t(lang, 'settings.title', siteName)}</h2>
      <button class="icon-btn" id="settings-close" type="button" aria-label={t(lang, 'settings.close')}>✕</button>
    </div>

    <div class="modal-note">{t(lang, 'settings.note')}</div>
    <p class="field-hint modal-env-hint">{t(lang, 'settings.envHint')}</p>

    <form id="keys-form">
      {GENERAL_FIELDS.map((field) => (
        <label class="field" for={`key-${field.name}`}>
          <span class="field-label">
            {t(lang, field.labelKey)} <code>{field.name}</code>
          </span>
          <div class="masked-row">
            <span class="masked-value" id={`masked-${field.name}`}>—</span>
            <span class="badge badge-muted" id={`badge-${field.name}`}>{t(lang, 'settings.notConfigured')}</span>
          </div>
          <input
            id={`key-${field.name}`}
            class="input"
            type="password"
            name={field.name}
            placeholder={t(lang, field.placeholderKey)}
            autocomplete="new-password"
            spellcheck="false"
          />
          <span class="field-hint">{t(lang, field.hintKey)}</span>
        </label>
      ))}

      <div class="field-divider">🖼️ {t(lang, 'settings.sectionR2')}</div>

      <!-- Live storage state (updated client-side once the vault is read) -->
      <div class="r2-status" role="status" aria-live="polite">
        <span class="badge badge-muted" id="r2-mode-badge">
          {t(lang, r2Configured ? 'settings.r2StatusConfigured' : 'settings.r2StatusGit')}
        </span>
      </div>

      <!-- Progressive-disclosure mini-guide (2026 UX: contextual, collapsible) -->
      <details class="r2-guide">
        <summary>{t(lang, 'settings.r2GuideTitle')}</summary>
        <ol class="r2-steps">
          <li>{t(lang, 'settings.r2Step1')}</li>
          <li>{t(lang, 'settings.r2Step2')}</li>
          <li>{t(lang, 'settings.r2Step3')}</li>
          <li>{t(lang, 'settings.r2Step4')}</li>
          <li class="r2-note">{t(lang, 'settings.r2Step5')}</li>
        </ol>
      </details>

      {R2_FIELDS.map((field) => (
        <label class="field" for={`key-${field.name}`}>
          <span class="field-label">
            {t(lang, field.labelKey)} <code>{field.name}</code>
          </span>
          <div class="masked-row">
            <span class="masked-value" id={`masked-${field.name}`}>—</span>
            <span class="badge badge-muted" id={`badge-${field.name}`}>{t(lang, 'settings.notConfigured')}</span>
          </div>
          <input
            id={`key-${field.name}`}
            class="input"
            type="password"
            name={field.name}
            placeholder={t(lang, field.placeholderKey)}
            autocomplete="new-password"
            spellcheck="false"
          />
          <span class="field-hint">{t(lang, field.hintKey)}</span>
        </label>
      ))}

      <div class="modal-actions">
        <button class="btn btn-ghost" type="button" id="settings-cancel">
          {t(lang, 'settings.cancel')}
        </button>
        <button class="btn btn-primary" type="submit" id="keys-save">
          {t(lang, 'settings.save')}
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { getClientLocale, t } from '../i18n';

  const lang = getClientLocale();

  const modal = document.getElementById('settings-modal') as HTMLElement;
  const form = document.getElementById('keys-form') as HTMLFormElement;
  const saveBtn = document.getElementById('keys-save') as HTMLButtonElement;
  const r2Badge = document.getElementById('r2-mode-badge') as HTMLElement | null;

  const FIELDS = [
    { name: 'DEEPSEEK_API_KEY', labelKey: 'settings.fieldDeepseek' },
    { name: 'GITHUB_PAT', labelKey: 'settings.fieldGithub' },
    { name: 'R2_ACCESS_KEY_ID', labelKey: 'settings.fieldR2AccessKey' },
    { name: 'R2_SECRET_ACCESS_KEY', labelKey: 'settings.fieldR2Secret' },
  ] as const;

  /** True when at least one key is already configured (vault or env). */
  let hasConfigured = false;

  /** The Save button is only enabled when at least one input has content. */
  function syncSaveState() {
    const anyValue = FIELDS.some((field) => {
      const input = document.getElementById(`key-${field.name}`) as HTMLInputElement | null;
      return Boolean(input?.value.trim());
    });
    saveBtn.disabled = !anyValue;
  }

  for (const field of FIELDS) {
    document
      .getElementById(`key-${field.name}`)
      ?.addEventListener('input', syncSaveState);
  }

  function toast(message: string, type: 'info' | 'success' | 'error' = 'info') {
    window.dispatchEvent(new CustomEvent('sc:toast', { detail: { message, type } }));
  }

  /** Live storage state: config (server) + keys presence (vault) → badge. */
  function updateR2Status(keysConfigured: boolean) {
    if (!r2Badge) return;
    const configured = modal.dataset.r2Configured === 'true';
    let text: string;
    let cls: string;
    if (configured && keysConfigured) {
      text = t(lang, 'settings.r2StatusConfigured');
      cls = 'badge badge-success';
    } else if (configured) {
      text = t(lang, 'settings.r2StatusNoKeys');
      cls = 'badge badge-warning';
    } else {
      text = t(lang, 'settings.r2StatusGit');
      cls = 'badge badge-muted';
    }
    r2Badge.textContent = text;
    r2Badge.className = cls;
  }

  function open() {
    modal.hidden = false;
    syncSaveState();
    loadMasked();
  }
  function close() {
    modal.hidden = true;
    form.reset();
    syncSaveState();
  }

  window.addEventListener('sc:open-settings', open);
  document.getElementById('settings-close')?.addEventListener('click', close);
  document.getElementById('settings-cancel')?.addEventListener('click', close);
  modal.addEventListener('click', (event) => {
    if (event.target === modal) close();
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !modal.hidden) close();
  });

  async function loadMasked() {
    try {
      const res = await fetch('/api/settings/keys');
      const data = await res.json();
      for (const field of FIELDS) {
        const value = data.configured?.[field.name];
        const source = data.sources?.[field.name] as 'vault' | 'env' | undefined;
        const el = document.getElementById(`masked-${field.name}`);
        const badge = document.getElementById(`badge-${field.name}`);
        if (el) el.textContent = value || '—';
        if (badge) {
          if (!value) {
            badge.textContent = t(lang, 'settings.notConfigured');
            badge.classList.add('badge-muted');
            badge.classList.remove('badge-success');
          } else {
            badge.textContent =
              source === 'env'
                ? t(lang, 'settings.configuredEnv')
                : t(lang, 'settings.configured');
            badge.classList.add('badge-success');
            badge.classList.remove('badge-muted');
          }
        }
      }
      updateR2Status(
        Boolean(data.configured?.R2_ACCESS_KEY_ID && data.configured?.R2_SECRET_ACCESS_KEY),
      );
      hasConfigured = Object.values(data.configured ?? {}).some(Boolean);
    } catch {
      toast(t(lang, 'settings.toastReadFailed'), 'error');
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const payload: Record<string, string> = {};
    for (const field of FIELDS) {
      const input = document.getElementById(`key-${field.name}`) as HTMLInputElement;
      if (input.value.trim()) payload[field.name] = input.value.trim();
    }
    if (!Object.keys(payload).length) {
      // Safety net (the Save button is disabled with empty inputs): a submit
      // can still arrive via implicit submission (Enter). If keys are already
      // configured, tell the user they are kept — not that something is wrong.
      toast(
        hasConfigured ? t(lang, 'settings.toastNoChanges') : t(lang, 'settings.toastEmpty'),
        'info',
      );
      return;
    }
    saveBtn.disabled = true;
    saveBtn.textContent = t(lang, 'settings.saving');
    try {
      const res = await fetch('/api/settings/keys', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Save failed');
      form.reset();
      await loadMasked();
      toast(t(lang, 'settings.toastSaved'), 'success');
    } catch (error) {
      toast(error instanceof Error ? error.message : 'Error', 'error');
    } finally {
      saveBtn.disabled = false;
      syncSaveState();
      saveBtn.textContent = t(lang, 'settings.save');
    }
  });
</script>
