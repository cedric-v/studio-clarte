---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../i18n';
import type { SiteConfig } from '../config/sites';
import type { SessionUser } from '../env';

interface Props {
  site: SiteConfig;
  user: SessionUser | null;
  isAgency: boolean;
  /** All sites — only passed in Super-Admin mode (multi-tenant isolation). */
  sites: SiteConfig[];
  activeSiteId: string;
}

const { site, user, isAgency, sites, activeSiteId } = Astro.props;
const { lang } = Astro.locals;
---

<header class="app-header">
  <div class="header-brand">
    {site.theme?.logoUrl ? (
      <img src={site.theme.logoUrl} alt={`Logo ${site.name}`} class="brand-logo" />
    ) : (
      <span class="brand-mark" aria-hidden="true">◐</span>
    )}
    <div class="brand-text">
      <h1 class="brand-name">{site.name}</h1>
      <span class="brand-sub">
        {isAgency ? t(lang, 'header.superAdmin') : t(lang, 'header.whiteLabel')} ·{' '}
        <code>{site.framework}</code> · <code>{site.repo}</code>
      </span>
    </div>
  </div>

  <div class="header-actions">
    {isAgency && sites.length > 1 && (
      <label class="site-switcher" title={t(lang, 'header.activeSite')}>
        <span class="hide-sm">{t(lang, 'header.activeSite')}</span>
        <select id="site-select" aria-label={t(lang, 'header.activeSite')}>
          {sites.map((candidate) => (
            <option value={candidate.id} selected={candidate.id === activeSiteId}>
              {candidate.name}{candidate.domain ? ` · ${candidate.domain}` : ''}
            </option>
          ))}
        </select>
      </label>
    )}

    <LanguageSwitcher />

    <button id="btn-reset" class="btn btn-ghost btn-reset" type="button" title={t(lang, 'header.resetTitle')}>
      ↺ <span class="hide-sm" id="reset-label">{t(lang, 'header.reset')}</span>
    </button>

    <button id="btn-open-settings" class="btn btn-ghost" type="button" title={t(lang, 'header.settings')}>
      ⚙️ <span class="hide-sm">{t(lang, 'header.settings')}</span>
    </button>

    {user && (
      <div class="user-chip" title={`@${user.login}`}>
        <img src={user.avatarUrl} alt="" class="user-avatar" width="28" height="28" />
        <span class="hide-sm">{user.name}</span>
      </div>
    )}

    <form method="post" action="/api/auth/logout">
      <button class="btn btn-ghost" type="submit" title={t(lang, 'header.logout')}>
        ⎋ <span class="hide-sm">{t(lang, 'header.logout')}</span>
      </button>
    </form>
  </div>
</header>

<script>
  import { getState, resetState, toast } from '../lib/client-state';
  import { getClientLocale, t } from '../i18n';

  const lang = getClientLocale();

  // Super-Admin site switcher: navigating to /?site=<id> sets the sc_site
  // cookie (middleware) and reloads with the new active site.
  document.getElementById('site-select')?.addEventListener('change', (event) => {
    const siteId = (event.target as HTMLSelectElement).value;
    if (siteId) window.location.href = `/?site=${encodeURIComponent(siteId)}`;
  });

  document.getElementById('btn-open-settings')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sc:open-settings'));
  });

  // Session reset — progressive confirmation (click → confirm within 3.5 s).
  // UX: no native confirm(); the button itself becomes the confirmation state.
  const btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
  const resetLabel = document.getElementById('reset-label') as HTMLElement | null;
  let confirmTimer: number | undefined;

  function armReset() {
    btnReset.classList.add('confirming');
    if (resetLabel) resetLabel.textContent = t(lang, 'header.resetConfirm');
    toast(
      getState().workflow ? t(lang, 'toast.resetWarnPr') : t(lang, 'toast.resetWarn'),
      'info',
    );
    confirmTimer = window.setTimeout(() => {
      confirmTimer = undefined;
      btnReset.classList.remove('confirming');
      if (resetLabel) resetLabel.textContent = t(lang, 'header.reset');
    }, 3500);
  }

  btnReset.addEventListener('click', () => {
    if (confirmTimer !== undefined) {
      // Second click → reset for real.
      window.clearTimeout(confirmTimer);
      confirmTimer = undefined;
      btnReset.classList.remove('confirming');
      if (resetLabel) resetLabel.textContent = t(lang, 'header.reset');
      resetState();
      window.dispatchEvent(new CustomEvent('sc:reset'));
      toast(t(lang, 'toast.resetDone'), 'success');
      return;
    }
    const state = getState();
    if (!state.messages.length && !state.payload) {
      toast(t(lang, 'toast.nothingToReset'), 'info');
      return;
    }
    armReset();
  });
</script>
